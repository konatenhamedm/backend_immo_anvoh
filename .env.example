# Configuration générale
# DEBUG est désactivé par défaut : True uniquement en développement. En production, SECRET_KEY est obligatoire.
DEBUG=True
SECRET_KEY=django-insecure-thiebbro-immo-clean-arch-secret-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées (site Next.js sur :3000, back-office admin-web sur :5173). Aucune autre origine n'est acceptée.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173

# Base de données PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=thiebbro_immo_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Durée de validité du jeton d'accès JWT (minutes). Le jeton de rafraîchissement dure 7 jours.
JWT_ACCESS_MINUTES=60

# Mot de passe des comptes de démonstration créés par `python manage.py seed_data` (sinon généré et affiché une fois).
# SEED_PASSWORD=

# --- Notifications par e-mail ------------------------------------------------------------------------------------
# Sans EMAIL_BACKEND : console du serveur en développement (DEBUG=True), SMTP en production.
# EMAIL_HOST=smtp.exemple.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=THIEBBRO IMMO <no-reply@thiebbro.ci>
# Adresse publique du site (liens dans les e-mails).
# FRONTEND_URL=http://localhost:3100
# Prospect sans activité depuis N jours -> tâche de relance (commande create_followups).

# Connexion avec Google (identifiant client OAuth « Web » créé dans Google Cloud Console). Vide = bouton masqué.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
