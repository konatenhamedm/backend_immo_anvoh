# Configuration de production (o2switch / cPanel). À copier en `.env` à la racine de l'application (à côté de manage.py),
# puis `chmod 600 .env`. Ne JAMAIS commiter le vrai fichier.
# Remplacer CPUSER par l'identifiant cPanel, thiebbro.ci par votre domaine.

DEBUG=False
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Sous-domaine de l'API, et origines autorisées à l'appeler (le site public).
ALLOWED_HOSTS=api.thiebbro.ci
CORS_ALLOWED_ORIGINS=https://thiebbro.ci,https://www.thiebbro.ci
CSRF_TRUSTED_ORIGINS=https://api.thiebbro.ci

# Base PostgreSQL créée dans cPanel (« Bases de données PostgreSQL »). Les noms sont préfixés par l'identifiant cPanel.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=CPUSER_thiebbro
DB_USER=CPUSER_thiebbro
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Base PostgreSQL DISTANTE (Neon, Supabase…) : décommenter ces deux lignes.
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60

# Fichiers : DANS la racine web du sous-domaine, pour que le serveur web les distribue directement.
STATIC_ROOT=/home/CPUSER/api.thiebbro.ci/static
MEDIA_ROOT=/home/CPUSER/api.thiebbro.ci/media

# E-mails (mot de passe oublié, codes de connexion, notifications) : compte créé dans cPanel > Comptes de messagerie.
# Port 587 + STARTTLS ; pour le port 465 : EMAIL_PORT=465, EMAIL_USE_TLS=False, EMAIL_USE_SSL=True.
EMAIL_HOST=mail.thiebbro.ci
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@thiebbro.ci
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=THIEBBRO IMMO <no-reply@thiebbro.ci>
# Adresse publique du site (liens dans les e-mails).
FRONTEND_URL=https://thiebbro.ci

JWT_ACCESS_MINUTES=60

# Connexion avec Google : ajouter https://thiebbro.ci aux « Origines JavaScript autorisées » dans Google Cloud.
# GOOGLE_CLIENT_ID=
# GOOGLE_STAFF_EMAILS=

# Base de démonstration uniquement : mot de passe imposé à tous les comptes chargés par load_demo_data.
# DEMO_ACCOUNTS_PASSWORD=
